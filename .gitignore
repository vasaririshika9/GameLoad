# ==========================================
# GameLoad AI — Root .gitignore
# High-Risk Security, Environment & Secrets
# ==========================================

# 1. Environment & Sensitive Configs (Keep secret keys & API tokens out of Git)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# 2. Private Keys, Certificates, and Credentials
*.pem
*.key
*.pkcs12
*.pfx
*.p12
*.cer
*.crt
id_rsa
id_dsa
id_ed25519
credentials.json
client_secret*.json
secrets.json
secrets.yaml
secrets.yml

# 3. Python Runtime & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
manifest
manifest.in

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# 4. Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.cache/
.parcel-cache/
.next/
out/
.turbo/
.vite/

# 5. Logs and Debugging Output
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 7. IDE, Editor & Workspace Files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
*.bak
*.sublime-project
*.sublime-workspace

# 8. Temporary and Backup files
tmp/
temp/
*.tmp
*.temp
